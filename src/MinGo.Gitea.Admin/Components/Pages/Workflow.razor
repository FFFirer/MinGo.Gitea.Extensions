@page "/workflow"

<h1 class="text-2xl font-semibold text-gray-800 mb-6">选择工作流</h1>

<Card Title="执行步骤">
    <Steps CurrentStep="2" />
</Card>

<Card Title="工作流列表">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        @foreach (var workflow in Workflows)
        {
            <WorkflowCard 
                Name="@workflow.Name" 
                Description="@workflow.Description" 
                Branch="@workflow.Branch" 
                IsActive="SelectedWorkflow == workflow.Name"
                OnSelect="SelectWorkflow"
            />
        }
    </div>
    <div class="mt-4 flex gap-2">
        <button class="px-4 py-2 bg-white border border-gray-300 rounded-md hover:bg-gray-50 transition-colors" @onclick="PrevStep">上一步</button>
        <button class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors" @onclick="NextStep" disabled="string.IsNullOrEmpty(SelectedWorkflow)">下一步</button>
    </div>
</Card>

<Toast Message="@ToastMessage" Type="@ToastType" Visible="@ShowToast" OnClose="CloseToast" />

@code {
    private string SelectedRepo { get; set; } = "";
    private string SelectedWorkflow { get; set; } = "";
    private string ToastMessage { get; set; } = "";
    private Toast.ToastType ToastType { get; set; } = Toast.ToastType.Success;
    private bool ShowToast { get; set; } = false;

    private List<WorkflowItem> Workflows { get; set; } = new List<WorkflowItem>
    {
        new WorkflowItem { Name = "CI/CD Pipeline", Description = "持续集成和部署流水线", Branch = "main" },
        new WorkflowItem { Name = "Code Quality", Description = "代码质量检查", Branch = "main" },
        new WorkflowItem { Name = "Security Scan", Description = "安全扫描", Branch = "main" }
    };

    protected override void OnInitialized()
    {
        // 从URL参数获取仓库信息
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        SelectedRepo = query["repo"] ?? "";
    }

    private async Task SelectWorkflow(string workflowName)
    {
        SelectedWorkflow = workflowName;
    }

    private async Task NextStep()
    {
        if (!string.IsNullOrEmpty(SelectedWorkflow))
        {
            ShowSuccessToast("成功选择工作流");
            // 跳转到选择分支页面
            NavigationManager.NavigateTo($"/branch?repo={SelectedRepo}&workflow={SelectedWorkflow}");
        }
    }

    private async Task PrevStep()
    {
        // 返回到选择仓库页面
        NavigationManager.NavigateTo("/trigger-workflow");
    }

    private void ShowSuccessToast(string message)
    {
        ToastMessage = message;
        ToastType = Toast.ToastType.Success;
        ShowToast = true;
    }

    private void CloseToast()
    {
        ShowToast = false;
    }

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    private class WorkflowItem
    {
        public string? Name { get; set; }
        public string? Description { get; set; }
        public string? Branch { get; set; }
    }
}