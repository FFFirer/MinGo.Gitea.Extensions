@page "/history/{id:int}"

<h1 class="text-2xl font-semibold text-gray-800 mb-6">工作流执行详情</h1>

@if (history == null)
{
    <div class="flex items-center justify-center h-64">
        <div class="text-gray-500">加载中...</div>
    </div>
}
else
{
    <Card Title="执行信息">
        <div class="mb-4">
            <label class="block text-sm font-medium text-gray-800 mb-2">工作流</label>
            <div class="w-full px-3 py-2 border border-gray-300 rounded-md bg-gray-50 cursor-default">@history.WorkflowName</div>
        </div>
        <div class="mb-4">
            <label class="block text-sm font-medium text-gray-800 mb-2">仓库</label>
            <div class="w-full px-3 py-2 border border-gray-300 rounded-md bg-gray-50 cursor-default">@history.Owner/@history.Repo</div>
        </div>
        <div class="mb-4">
            <label class="block text-sm font-medium text-gray-800 mb-2">分支</label>
            <div class="w-full px-3 py-2 border border-gray-300 rounded-md bg-gray-50 cursor-default">@history.Ref</div>
        </div>
        <div class="mb-4">
            <label class="block text-sm font-medium text-gray-800 mb-2">执行状态</label>
            <div class="w-full px-3 py-2 border border-gray-300 rounded-md @GetStatusClass(history.Status) cursor-default">@history.Status</div>
        </div>
        <div class="mb-4">
            <label class="block text-sm font-medium text-gray-800 mb-2">创建时间</label>
            <div class="w-full px-3 py-2 border border-gray-300 rounded-md bg-gray-50 cursor-default">@history.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</div>
        </div>
        <div class="mb-4">
            <label class="block text-sm font-medium text-gray-800 mb-2">更新时间</label>
            <div class="w-full px-3 py-2 border border-gray-300 rounded-md bg-gray-50 cursor-default">@history.UpdatedAt.ToString("yyyy-MM-dd HH:mm:ss")</div>
        </div>
        <div class="mb-4">
            <label class="block text-sm font-medium text-gray-800 mb-2">工作流开始执行时间</label>
            <div class="w-full px-3 py-2 border border-gray-300 rounded-md bg-gray-50 cursor-default">@(history.StartedAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "")</div>
        </div>
        <div class="mb-4">
            <label class="block text-sm font-medium text-gray-800 mb-2">工作流结束执行时间</label>
            <div class="w-full px-3 py-2 border border-gray-300 rounded-md bg-gray-50 cursor-default">@(history.EndedAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "")</div>
        </div>
        <div class="mb-4">
            <label class="block text-sm font-medium text-gray-800 mb-2">触发类型</label>
            <div class="w-full px-3 py-2 border border-gray-300 rounded-md bg-gray-50 cursor-default">@history.TriggerType</div>
        </div>
        <div class="mb-4">
            <label class="block text-sm font-medium text-gray-800 mb-2">Run ID</label>
            <div class="w-full px-3 py-2 border border-gray-300 rounded-md bg-gray-50 cursor-default">@history.RunId</div>
        </div>
        <div class="mb-4">
            <label class="block text-sm font-medium text-gray-800 mb-2">Commit SHA</label>
            <div class="w-full px-3 py-2 border border-gray-300 rounded-md bg-gray-50 cursor-default">@history.CommitSha</div>
        </div>
        <button class="px-4 py-2 bg-white border border-gray-300 rounded-md hover:bg-gray-50 transition-colors" @onclick="BackToHistory">返回历史</button>
    </Card>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private WorkflowRunHistory? history;

    [Inject]
    private WorkflowService WorkflowService { get; set; } = default!;

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        history = await WorkflowService.GetWorkflowRunHistoryByIdAsync(Id);
    }

    private string GetStatusClass(string status)
    {
        return status switch
        {
            "running" => "bg-green-50 text-green-700",
            "completed" => "bg-blue-50 text-blue-700",
            "failed" => "bg-red-50 text-red-700",
            "canceled" => "bg-gray-50 text-gray-700",
            _ => "bg-gray-50 text-gray-700"
        };
    }

    private async Task BackToHistory()
    {
        NavigationManager.NavigateTo("/history");
    }
}