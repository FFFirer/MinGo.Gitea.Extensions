@page "/branch"

<h1 class="text-2xl font-semibold text-gray-800 mb-6">选择分支</h1>

<Card Title="执行步骤">
    <Steps CurrentStep="3" />
</Card>

<Card Title="分支列表">
    <div class="mb-4">
        <label class="block text-sm font-medium text-gray-800 mb-2" for="branch-select">分支</label>
        <select class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" id="branch-select" @bind="SelectedBranch">
            <option value="">请选择分支</option>
            <option value="main">main</option>
            <option value="develop">develop</option>
            <option value="feature-branch">feature-branch</option>
        </select>
    </div>
    <div class="mt-4 flex gap-2">
        <button class="px-4 py-2 bg-white border border-gray-300 rounded-md hover:bg-gray-50 transition-colors" @onclick="PrevStep">上一步</button>
        <button class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors" @onclick="NextStep" disabled="string.IsNullOrEmpty(SelectedBranch)">下一步</button>
    </div>
</Card>

<Toast Message="@ToastMessage" Type="@ToastType" Visible="@ShowToast" OnClose="CloseToast" />

@code {
    private string SelectedRepo { get; set; } = "";
    private string SelectedWorkflow { get; set; } = "";
    private string SelectedBranch { get; set; } = "";
    private string ToastMessage { get; set; } = "";
    private Toast.ToastType ToastType { get; set; } = Toast.ToastType.Success;
    private bool ShowToast { get; set; } = false;

    protected override void OnInitialized()
    {
        // 从URL参数获取仓库和工作流信息
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        SelectedRepo = query["repo"] ?? "";
        SelectedWorkflow = query["workflow"] ?? "";
    }

    private async Task NextStep()
    {
        if (!string.IsNullOrEmpty(SelectedBranch))
        {
            ShowSuccessToast("成功选择分支");
            // 跳转到确认触发页面
            NavigationManager.NavigateTo($"/confirm-trigger?repo={SelectedRepo}&workflow={SelectedWorkflow}&branch={SelectedBranch}");
        }
    }

    private async Task PrevStep()
    {
        // 返回到选择工作流页面
        NavigationManager.NavigateTo($"/workflow?repo={SelectedRepo}");
    }

    private void ShowSuccessToast(string message)
    {
        ToastMessage = message;
        ToastType = Toast.ToastType.Success;
        ShowToast = true;
    }

    private void CloseToast()
    {
        ShowToast = false;
    }

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;
}