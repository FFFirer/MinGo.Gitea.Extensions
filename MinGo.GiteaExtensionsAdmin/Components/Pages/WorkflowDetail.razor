@page "/workflow-detail"

<h1 class="text-2xl font-semibold text-gray-800 mb-6">工作流执行详情</h1>

<Card Title="执行信息">
    <div class="mb-4">
        <label class="block text-sm font-medium text-gray-800 mb-2">工作流</label>
        <div class="w-full px-3 py-2 border border-gray-300 rounded-md bg-gray-50 cursor-default">CI/CD Pipeline</div>
    </div>
    <div class="mb-4">
        <label class="block text-sm font-medium text-gray-800 mb-2">仓库</label>
        <div class="w-full px-3 py-2 border border-gray-300 rounded-md bg-gray-50 cursor-default">minio/minio</div>
    </div>
    <div class="mb-4">
        <label class="block text-sm font-medium text-gray-800 mb-2">分支</label>
        <div class="w-full px-3 py-2 border border-gray-300 rounded-md bg-gray-50 cursor-default">main</div>
    </div>
    <div class="mb-4">
        <label class="block text-sm font-medium text-gray-800 mb-2">执行状态</label>
        <div class="w-full px-3 py-2 border border-gray-300 rounded-md bg-green-50 text-green-700 cursor-default">运行中</div>
    </div>
    <div class="mb-4">
        <label class="block text-sm font-medium text-gray-800 mb-2">开始时间</label>
        <div class="w-full px-3 py-2 border border-gray-300 rounded-md bg-gray-50 cursor-default">2026-03-06 12:00:00</div>
    </div>
    <button class="px-4 py-2 bg-white border border-gray-300 rounded-md hover:bg-gray-50 transition-colors" @onclick="BackToHistory">返回历史</button>
</Card>

@code {
    private async Task BackToHistory()
    {
        // 返回到历史页面
        NavigationManager.NavigateTo("/history");
    }

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;
}