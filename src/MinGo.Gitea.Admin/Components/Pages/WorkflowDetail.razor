@page "/history/{id:int}"

<h1 class="text-2xl font-semibold text-ink mb-6">工作流执行详情</h1>

@if (history == null)
{
    <div class="flex items-center justify-center h-64">
        <div class="text-ink-muted">加载中...</div>
    </div>
}
else
{
    <Card Title="执行信息">
        <div class="mb-4">
            <label class="block text-sm font-medium text-ink mb-2">工作流</label>
            <div class="w-full px-3 py-2 border border-line rounded-md bg-surface-2 cursor-default">@history.WorkflowName</div>
        </div>
        <div class="mb-4">
            <label class="block text-sm font-medium text-ink mb-2">仓库</label>
            <div class="w-full px-3 py-2 border border-line rounded-md bg-surface-2 cursor-default">@history.Owner/@history.Repo</div>
        </div>
        <div class="mb-4">
            <label class="block text-sm font-medium text-ink mb-2">Git Ref</label>
            <div class="w-full px-3 py-2 border border-line rounded-md bg-surface-2 cursor-default">@history.Ref</div>
        </div>
        <div class="mb-4">
            <label class="block text-sm font-medium text-ink mb-2">执行状态</label>
            <div class="w-full px-3 py-2 border border-line rounded-md @GetStatusClass(history.Status) cursor-default">@history.Status</div>
        </div>
        <div class="mb-4">
            <label class="block text-sm font-medium text-ink mb-2">执行结果</label>
            <div class="w-full px-3 py-2 border border-line rounded-md @GetConclusionClass(history.Conclusion) cursor-default">@(string.IsNullOrEmpty(history.Conclusion) ? "-" : history.Conclusion)</div>
        </div>
        <div class="mb-4">
            <label class="block text-sm font-medium text-ink mb-2">创建时间</label>
            <div class="w-full px-3 py-2 border border-line rounded-md bg-surface-2 cursor-default">@history.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</div>
        </div>
        <div class="mb-4">
            <label class="block text-sm font-medium text-ink mb-2">更新时间</label>
            <div class="w-full px-3 py-2 border border-line rounded-md bg-surface-2 cursor-default">@history.UpdatedAt.ToString("yyyy-MM-dd HH:mm:ss")</div>
        </div>
        <div class="mb-4">
            <label class="block text-sm font-medium text-ink mb-2">工作流开始执行时间</label>
            <div class="w-full px-3 py-2 border border-line rounded-md bg-surface-2 cursor-default">@(history.StartedAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "")</div>
        </div>
        <div class="mb-4">
            <label class="block text-sm font-medium text-ink mb-2">工作流结束执行时间</label>
            <div class="w-full px-3 py-2 border border-line rounded-md bg-surface-2 cursor-default">@(history.EndedAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "")</div>
        </div>
        <div class="mb-4">
            <label class="block text-sm font-medium text-ink mb-2">触发类型</label>
            <div class="w-full px-3 py-2 border border-line rounded-md bg-surface-2 cursor-default">@history.TriggerType</div>
        </div>
        <div class="mb-4">
            <label class="block text-sm font-medium text-ink mb-2">Run ID</label>
            <div class="w-full px-3 py-2 border border-line rounded-md bg-surface-2 cursor-default">@history.RunId</div>
        </div>
        <div class="mb-4">
            <label class="block text-sm font-medium text-ink mb-2">Commit SHA</label>
            <div class="w-full px-3 py-2 border border-line rounded-md bg-surface-2 cursor-default">@history.CommitSha</div>
        </div>
        @if (!string.IsNullOrEmpty(history.Inputs))
        {
            <div class="mb-4">
                <label class="block text-sm font-medium text-ink mb-2">输入参数</label>
                <div class="w-full px-3 py-2 border border-line rounded-md bg-surface-2 cursor-default">
                    @GetFormattedInputs(history.Inputs)
                </div>
            </div>
        }
        <div class="flex space-x-4">
            <button class="px-4 py-2 bg-success-btn text-on-accent rounded-md hover:bg-success-btn-hover transition-colors" @onclick="ShowSaveTemplateDialog" disabled="@isLoading">
                @if (isSavingTemplate)
                {
                    <div class="flex items-center">
                        <div class="animate-spin rounded-full h-4 w-4 border-b-2 border-white mr-2"></div>
                        保存中...
                    </div>
                }
                else
                {
                    @("保存为模板")
                }
            </button>
            <button class="px-4 py-2 bg-accent-btn text-on-accent rounded-md hover:bg-accent-btn-hover transition-colors" @onclick="ReRunWorkflow" disabled="@isLoading">
                @if (isLoading)
                {
                    <div class="flex items-center">
                        <div class="animate-spin rounded-full h-4 w-4 border-b-2 border-white mr-2"></div>
                        执行中...
                    </div>
                }
                else
                {
                    @("再执行一次")
                }
            </button>
            <button class="px-4 py-2 bg-surface border border-line rounded-md hover:bg-surface-2 transition-colors" @onclick="BackToHistory" disabled="@isLoading">返回历史</button>
        </div>
    </Card>
}

@if (showSaveTemplateDialog)
{
    <div class="fixed inset-0 bg-black/50 flex items-center justify-center z-50">
        <div class="bg-surface rounded-lg shadow-xl p-6 w-full max-w-md">
            <h3 class="text-lg font-semibold text-ink mb-4">保存为模板</h3>
            <div class="mb-4">
                <label class="block text-sm font-medium text-ink mb-2">模板名称</label>
                <input type="text" class="w-full px-3 py-2 border border-line rounded-md focus:outline-none focus:ring-2 focus:ring-success" 
                       placeholder="请输入模板名称" @bind="templateName" @bind:event="oninput">
            </div>
            <div class="flex justify-end space-x-3">
                <button class="px-4 py-2 bg-surface border border-line rounded-md hover:bg-surface-2 transition-colors" @onclick="CancelSaveTemplate">取消</button>
                <button class="px-4 py-2 bg-success-btn text-on-accent rounded-md hover:bg-success-btn-hover transition-colors" 
                        @onclick="SaveTemplate" disabled="@isSavingTemplate">确定</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private WorkflowRunHistory? history;
    private bool isLoading = false;
    private bool showSaveTemplateDialog = false;
    private string templateName = string.Empty;
    private bool isSavingTemplate = false;

    [Inject]
    private WorkflowService WorkflowService { get; set; } = default!;

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await LoadWorkflowHistory();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadWorkflowHistory();
    }

    private async Task LoadWorkflowHistory()
    {
        history = await WorkflowService.GetWorkflowRunHistoryByIdAsync(Id);
    }

    private string GetStatusClass(string status)
    {
        return status switch
        {
            "running" => "bg-success-soft text-success",
            "completed" => "bg-info-soft text-info",
            "failed" => "bg-danger-soft text-danger",
            "canceled" => "bg-surface-2 text-ink",
            _ => "bg-surface-2 text-ink"
        };
    }

    private string GetFormattedInputs(string inputsJson)
    {
        try
        {
            var inputs = Newtonsoft.Json.JsonConvert.DeserializeObject<Dictionary<string, string>>(inputsJson);
            if (inputs == null || inputs.Count == 0)
            {
                return "-";
            }
            return string.Join(", ", inputs.Select(kv => $"{kv.Key}: {kv.Value}"));
        }
        catch
        {
            return inputsJson;
        }
    }

    /// <summary>
    /// 根据执行结果获取对应的CSS类
    /// </summary>
    /// <param name="conclusion">执行结果</param>
    /// <returns>CSS类名</returns>
    private string GetConclusionClass(string conclusion)
    {
        if (string.IsNullOrEmpty(conclusion))
        {
            return "bg-surface-2 text-ink";
        }
        
        return conclusion switch
        {
            "success" => "bg-success-soft text-success",
            "failure" => "bg-danger-soft text-danger",
            "canceled" => "bg-surface-2 text-ink",
            "skipped" => "bg-warn-soft text-warn",
            _ => "bg-surface-2 text-ink"
        };
    }

    private async Task BackToHistory()
    {
        NavigationManager.NavigateTo("/history");
    }

    /// <summary>
    /// 显示保存模板对话框
    /// </summary>
    private void ShowSaveTemplateDialog()
    {
        if (history != null)
        {
            templateName = $"{history.WorkflowName}_{history.Ref}";
            showSaveTemplateDialog = true;
        }
    }

    /// <summary>
    /// 保存为模板
    /// </summary>
    private async Task SaveTemplate()
    {
        if (history == null || string.IsNullOrWhiteSpace(templateName))
        {
            return;
        }

        try
        {
            isSavingTemplate = true;
            await WorkflowService.SaveTemplateAsync(templateName, history);
            showSaveTemplateDialog = false;
            templateName = string.Empty;
        }
        finally
        {
            isSavingTemplate = false;
        }
    }

    /// <summary>
    /// 取消保存模板
    /// </summary>
    private void CancelSaveTemplate()
    {
        showSaveTemplateDialog = false;
        templateName = string.Empty;
    }

    /// <summary>
    /// 再执行一次工作流
    /// </summary>
    private async Task ReRunWorkflow()
    {
        if (history == null)
        {
            return;
        }

        try
        {
            isLoading = true;

            // 创建工作流对象
            var workflow = new Core.Models.Workflow
            {
                Id = history.WorkflowId,
                Name = history.WorkflowName,
                Path = "",
                State = "active",
                ConnectionId = history.ConnectionId,
                Provider = history.Provider
            };

            // 获取最新的 ref 信息
            var refInfo = await WorkflowService.GetRefAsync(history.Owner, history.Repo, history.Ref, history.ConnectionId);
            if (refInfo == null || refInfo.Commit == null)
            {
                throw new Exception($"无法获取引用 {history.Ref} 的最新提交信息");
            }

            // 创建Ref对象
            var @ref = new Core.Models.Ref
            {
                Name = history.Ref,
                Type = history.Ref.StartsWith("refs/heads/") ? "branch" : history.Ref.StartsWith("refs/tags/") ? "tag" : "unknown",
                Commit = refInfo.Commit
            };

            // 触发工作流
            var newHistory = await WorkflowService.TriggerWorkflowAsync(
                history.Owner,
                history.Repo,
                workflow,
                @ref,
                "手动触发"
            );

            // 跳转到新的工作流执行详情页
            if (newHistory != null)
            {
                NavigationManager.NavigateTo($"/history/{newHistory.Id}");
            }
            else
            {
                // 如果创建失败，跳转到历史页面
                NavigationManager.NavigateTo("/history");
            }
        }
        finally
        {
            isLoading = false;
        }
    }
}