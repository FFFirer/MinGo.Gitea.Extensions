@page "/"

<h1 class="text-2xl font-semibold text-ink mb-6">工作流执行概览</h1>

@if (isLoading)
{
    <div class="flex items-center justify-center h-64">
        <div class="text-ink-muted">加载中...</div>
    </div>
}
else
{
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
        <Card Title="总执行次数">
            <div class="text-3xl font-semibold text-ink mt-2">@totalRunCount</div>
            <div class="text-xs text-ink-muted mt-1">本月执行 @monthlyRunCount 次</div>
        </Card>
        
        <Card Title="成功率">
            <div class="text-3xl font-semibold text-success mt-2">@successRate%</div>
            <div class="text-xs text-ink-muted mt-1">@successfulRuns/@totalRunCount 成功</div>
        </Card>
        
        <Card Title="平均执行时间">
            <div class="text-3xl font-semibold text-ink mt-2">@averageExecutionTime</div>
            <div class="text-xs text-ink-muted mt-1">最近 10 次执行</div>
        </Card>
        
        <Card Title="运行中">
            <div class="text-3xl font-semibold text-warn mt-2">@runningRunCount</div>
            <div class="text-xs text-ink-muted mt-1">当前正在执行</div>
        </Card>
    </div>

    <Card Title="最近执行记录">
        <div class="overflow-x-auto">
            <table class="w-full border-collapse">
                <thead>
                    <tr class="border-b border-line">
                        <th class="px-4 py-3 text-left text-sm font-semibold text-ink">工作流</th>
                        <th class="px-4 py-3 text-left text-sm font-semibold text-ink">仓库</th>
                        <th class="px-4 py-3 text-left text-sm font-semibold text-ink">状态</th>
                        <th class="px-4 py-3 text-left text-sm font-semibold text-ink">结果</th>
                        <th class="px-4 py-3 text-left text-sm font-semibold text-ink">开始时间</th>
                        <th class="px-4 py-3 text-left text-sm font-semibold text-ink">执行时间</th>
                        <th class="px-4 py-3 text-left text-sm font-semibold text-ink">操作</th>
                    </tr>
                </thead>
                <tbody>
                    @if (recentRuns?.Any() == true)
                    {
                        @foreach (var run in recentRuns)
                        {
                            <tr class="border-b border-line hover:bg-surface-2 transition-colors">
                                <td class="px-4 py-3 text-sm text-ink">@run.WorkflowName</td>
                                <td class="px-4 py-3 text-sm text-ink-muted">@run.Owner/@run.Repo</td>
                                <td class="px-4 py-3">
                                    <StatusBadge Status="@GetStatusType(run.Status)" />
                                </td>
                                <td class="px-4 py-3 text-sm text-ink-muted">@(string.IsNullOrEmpty(run.Conclusion) ? "-" : run.Conclusion)</td>
                                <td class="px-4 py-3 text-sm text-ink-muted">@run.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td class="px-4 py-3 text-sm text-ink-muted">@GetExecutionTime(run)</td>
                                <td class="px-4 py-3">
                                    <button class="text-xs px-2 py-1 bg-surface border border-line rounded hover:bg-surface-2 transition-colors mr-2" @onclick="() => ViewRunDetails(run.Id)">查看</button>
                                    <button class="text-xs px-2 py-1 bg-accent-btn text-on-accent border border-accent-btn rounded hover:bg-accent-btn-hover transition-colors" @onclick="() => ReRunWorkflow(run)">再执行一次</button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="px-4 py-6 text-center text-ink-muted">暂无执行记录</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </Card>

    <Card Title="最近触发模板">
        <div class="overflow-x-auto">
            <table class="w-full border-collapse">
                <thead>
                    <tr class="border-b border-line">
                        <th class="px-4 py-3 text-left text-sm font-semibold text-ink">模板名称</th>
                        <th class="px-4 py-3 text-left text-sm font-semibold text-ink">仓库</th>
                        <th class="px-4 py-3 text-left text-sm font-semibold text-ink">工作流</th>
                        <th class="px-4 py-3 text-left text-sm font-semibold text-ink">分支</th>
                        <th class="px-4 py-3 text-left text-sm font-semibold text-ink">最后触发时间</th>
                        <th class="px-4 py-3 text-left text-sm font-semibold text-ink">操作</th>
                    </tr>
                </thead>
                <tbody>
                    @if (recentTemplates?.Any() == true)
                    {
                        @foreach (var template in recentTemplates)
                        {
                            <tr class="border-b border-line hover:bg-surface-2 transition-colors">
                                <td class="px-4 py-3 text-sm text-ink">@template.Name</td>
                                <td class="px-4 py-3 text-sm text-ink-muted">@template.Owner/@template.Repo</td>
                                <td class="px-4 py-3 text-sm text-ink">@template.WorkflowName</td>
                                <td class="px-4 py-3 text-sm text-ink-muted">@template.Ref</td>
                                <td class="px-4 py-3 text-sm text-ink-muted">@(template.LastTriggeredAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "-")</td>
                                <td class="px-4 py-3">
                                    <button class="text-xs px-2 py-1 bg-accent-btn text-on-accent border border-accent-btn rounded hover:bg-accent-btn-hover transition-colors mr-2" @onclick="() => ExecuteTemplate(template)">执行</button>
                                    <button class="text-xs px-2 py-1 bg-surface border border-line rounded hover:bg-surface-2 transition-colors" @onclick="() => ViewTemplate(template)">查看</button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="px-4 py-6 text-center text-ink-muted">暂无触发模板</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </Card>
}

@code {
    private bool isLoading = true;
    private int totalRunCount;
    private int monthlyRunCount;
    private int successfulRuns;
    private int successRate;
    private string averageExecutionTime = "N/A";
    private int runningRunCount;
    private IEnumerable<WorkflowRunHistory> recentRuns = Enumerable.Empty<WorkflowRunHistory>();
    private IEnumerable<WorkflowTriggerTemplate> recentTemplates = Enumerable.Empty<WorkflowTriggerTemplate>();

    [Inject]
    private WorkflowService WorkflowService { get; set; } = default!;

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardData();
    }

    private async Task LoadDashboardData()
    {
        isLoading = true;

        try
        {
            // 获取总执行次数
            totalRunCount = await WorkflowService.GetTotalRunCountAsync();

            // 获取本月执行次数
            monthlyRunCount = await WorkflowService.GetMonthlyRunCountAsync();

            // 获取成功率
            var (successful, total) = await WorkflowService.GetSuccessRateAsync();
            successfulRuns = successful;
            successRate = total > 0 ? (int)((double)successful / total * 100) : 0;

            // 获取平均执行时间
            var avgTime = await WorkflowService.GetAverageExecutionTimeAsync();
            averageExecutionTime = avgTime.HasValue 
                ? $"{avgTime.Value.Minutes}m {avgTime.Value.Seconds}s"
                : "N/A";

            // 获取运行中次数
            runningRunCount = await WorkflowService.GetRunningRunCountAsync();

            // 获取最近执行记录
            recentRuns = await WorkflowService.GetRecentRunsAsync(5);

            // 获取最近触发模板
            recentTemplates = (await WorkflowService.GetTemplatesAsync())
                .OrderByDescending(t => t.LastTriggeredAt ?? t.CreatedAt)
                .Take(5);
        }
        catch (Exception ex)
        {
            // 处理错误
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetStatusType(string status)
    {
        return status switch
        {
            "running" => "running",
            "in_progress" => "in_progress",
            "queued" => "in_progress",
            "waiting" => "in_progress",
            "pending" => "in_progress",
            "completed" => "completed",
            "success" => "completed",
            "failed" => "failed",
            "failure" => "failed",
            "canceled" => "canceled",
            "cancelled" => "canceled",
            "skipped" => "completed",
            _ => status.ToLower()
        };
    }

    /// <summary>
    /// 计算工作流执行时间
    /// </summary>
    /// <param name="run">工作流执行历史</param>
    /// <returns>执行时间字符串</returns>
    private string GetExecutionTime(WorkflowRunHistory run)
    {
        if (!run.StartedAt.HasValue)
        {
            return "未知";
        }
        
        if (!run.EndedAt.HasValue)
        {
            return "运行中";
        }
        
        var duration = run.EndedAt.Value - run.StartedAt.Value;
        return $"{duration.Minutes}m {duration.Seconds}s";
    }

    private void ViewRunDetails(int id)
    {
        NavigationManager.NavigateTo($"/history/{id}");
    }

    /// <summary>
    /// 查看模板详情，跳转到模板列表页面
    /// </summary>
    private void ViewTemplate(WorkflowTriggerTemplate template)
    {
        NavigationManager.NavigateTo("/templates");
    }

    /// <summary>
    /// 执行工作流触发模板
    /// </summary>
    private async Task ExecuteTemplate(WorkflowTriggerTemplate template)
    {
        try
        {
            isLoading = true;

            var workflow = new Core.Models.Workflow
            {
                Id = template.WorkflowId,
                Name = template.WorkflowName,
                Path = "",
                State = "active",
                ConnectionId = template.ConnectionId,
                Provider = template.Provider
            };

            var @ref = await WorkflowService.GetRefAsync(template.Owner, template.Repo, template.Ref, template.ConnectionId);
            if (@ref == null || @ref.Commit == null)
            {
                throw new Exception($"无法获取引用 {template.Ref} 的最新提交信息");
            }

            var newHistory = await WorkflowService.TriggerWorkflowAsync(
                template.Owner,
                template.Repo,
                workflow,
                @ref,
                "模板触发"
            );

            if (newHistory != null)
            {
                NavigationManager.NavigateTo($"/history/{newHistory.Id}");
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    /// <summary>
    /// 再执行一次工作流
    /// </summary>
    private async Task ReRunWorkflow(WorkflowRunHistory run)
    {
        try
        {
            isLoading = true;

            // 创建工作流对象
            var workflow = new Core.Models.Workflow
            {
                Id = run.WorkflowId,
                Name = run.WorkflowName,
                Path = "",
                State = "active",
                ConnectionId = run.ConnectionId,
                Provider = run.Provider
            };

            // 获取最新的 commit 信息
            var @ref = await WorkflowService.GetRefAsync(run.Owner, run.Repo, run.Ref, run.ConnectionId);
            if (@ref == null || @ref.Commit == null)
            {
                throw new Exception($"无法获取引用 {run.Ref} 的最新提交信息");
            }

            // 触发工作流
            var newHistory = await WorkflowService.TriggerWorkflowAsync(
                run.Owner,
                run.Repo,
                workflow,
                @ref,
                "手动触发"
            );

            // 跳转到新的工作流执行详情页
            if (newHistory != null)
            {
                NavigationManager.NavigateTo($"/history/{newHistory.Id}");
            }
        }
        finally
        {
            isLoading = false;
        }
    }
}