<div class="bg-white rounded-lg shadow-sm p-4 cursor-pointer transition-all duration-200 hover:shadow-md hover:-translate-y-1 @(IsActive ? "border-2 border-blue-600" : "")" @onclick="SelectWorkflow">
    <div class="workflow-name text-base font-medium text-gray-800 mb-2">@Name</div>
    <div class="workflow-description text-xs text-gray-500 mb-3">@Description</div>
    <div class="workflow-branch text-xs text-gray-500 bg-gray-100 px-2 py-1 rounded">@Branch</div>
</div>

@code {
    [Parameter]
    public string? Name { get; set; }

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public string? Branch { get; set; }

    [Parameter]
    public bool IsActive { get; set; }

    [Parameter]
    public EventCallback<string> OnSelect { get; set; }

    private async Task SelectWorkflow()
    {
        await OnSelect.InvokeAsync(Name);
    }
}