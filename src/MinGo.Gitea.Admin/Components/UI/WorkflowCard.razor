<div class="bg-surface rounded-lg shadow-sm p-4 cursor-pointer transition-all duration-200 @(IsActive ? "border-2 border-accent-btn" : "")" @onclick="SelectWorkflow">
    <div class="workflow-name text-base font-medium text-ink mb-2">@Name</div>
    <div class="workflow-description text-xs text-ink-muted mb-3">@Description</div>
    <div class="workflow-branch text-xs text-ink-muted bg-surface-2 px-2 py-1 rounded">@Branch</div>
</div>

@code {
    [Parameter]
    public string? Name { get; set; }

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public string? Branch { get; set; }

    [Parameter]
    public bool IsActive { get; set; }

    [Parameter]
    public EventCallback<string> OnSelect { get; set; }

    private async Task SelectWorkflow()
    {
        await OnSelect.InvokeAsync(Name);
    }
}