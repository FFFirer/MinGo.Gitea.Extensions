{
  "Gitea": {
    "ServerUrl": "https://gitea.example.com",
    "Token": "your-gitea-token",
    "Username": "your-username"
  }
}

// 注意：请使用以下命令设置实际的用户机密
// dotnet user-secrets set "Gitea:ServerUrl" "https://your-gitea-server.com"
// dotnet user-secrets set "Gitea:Token" "your-actual-token"
// dotnet user-secrets set "Gitea:Username" "your-username"

// 运行测试时，需要设置环境变量：
// set RUN_GITEA_API_TESTS=1 (Windows)
// export RUN_GITEA_API_TESTS=1 (Linux/Mac)
