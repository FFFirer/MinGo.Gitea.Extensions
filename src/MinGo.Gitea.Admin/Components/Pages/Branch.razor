@page "/branch"

<h1 class="text-2xl font-semibold text-gray-800 mb-6">选择分支</h1>

<Card Title="执行步骤">
    <Steps CurrentStep="3" />
</Card>

<Card Title="选择分支">
    <div class="mb-4">
        <label class="block text-sm font-medium text-gray-800 mb-2">当前仓库</label>
        <div class="w-full px-3 py-2 border border-gray-300 rounded-md bg-gray-50 cursor-default">@SelectedRepo</div>
    </div>
    
    @if (IsLoading)
    {
        <div class="flex justify-center items-center py-8">
            <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600"></div>
        </div>
    }
    else if (Branches.Count == 0)
    {
        <div class="text-center py-8 text-gray-500">
            该仓库没有可用的分支
        </div>
    }
    else
    {
        <div class="mb-4">
            <label class="block text-sm font-medium text-gray-800 mb-2" for="branch-select">分支</label>
            <select class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" id="branch-select" @bind="SelectedBranch">
                <option value="">请选择分支</option>
                @foreach (var branch in Branches)
                {
                    <option value="@branch.Name">@branch.Name</option>
                }
            </select>
        </div>
    }
    
    <div class="mt-6 flex gap-2">
        <button class="px-4 py-2 bg-white border border-gray-300 rounded-md hover:bg-gray-50 transition-colors" @onclick="PrevStep">上一步</button>
        <button class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors" @onclick="NextStep" disabled="@string.IsNullOrEmpty(SelectedBranch)">下一步</button>
    </div>
</Card>

<Toast Message="@ToastMessage" Type="@ToastType" Visible="@ShowToast" OnClose="CloseToast" />

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public string? Repo { get; set; }
    
    [Parameter]
    [SupplyParameterFromQuery]
    public string? WorkflowId { get; set; }
    
    private string SelectedRepo { get; set; } = "";
    private string SelectedWorkflowId { get; set; } = "";
    private string SelectedBranch { get; set; } = "";
    private string ToastMessage { get; set; } = "";
    private Toast.ToastType ToastType { get; set; } = Toast.ToastType.Success;
    private bool ShowToast { get; set; } = false;
    private List<MinGo.Gitea.Core.Models.Branch> Branches { get; set; } = new List<MinGo.Gitea.Core.Models.Branch>();
    private bool IsLoading { get; set; } = false;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(Repo) || string.IsNullOrEmpty(WorkflowId))
        {
            NavigationManager.NavigateTo("/trigger-workflow");
            return;
        }
        
        SelectedRepo = Repo;
        SelectedWorkflowId = WorkflowId;
        await LoadBranchesAsync();
    }

    private async Task LoadBranchesAsync()
    {
        IsLoading = true;
        try
        {
            var (owner, repo) = ParseRepo(SelectedRepo);
            var branches = await WorkflowService.GetBranchesAsync(owner, repo);
            Branches = branches.ToList();
        }
        catch (Exception ex)
        {
            ShowErrorToast($"加载分支失败: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private (string owner, string repo) ParseRepo(string repoFullName)
    {
        var parts = repoFullName.Split('/');
        if (parts.Length != 2)
        {
            throw new Exception("仓库格式错误");
        }
        return (parts[0], parts[1]);
    }

    private void NextStep()
    {
        if (!string.IsNullOrEmpty(SelectedBranch))
        {
            NavigationManager.NavigateTo($"/confirm-trigger?repo={SelectedRepo}&workflowId={SelectedWorkflowId}&branch={SelectedBranch}");
        }
        else
        {
            ShowErrorToast("请选择分支");
        }
    }

    private void PrevStep()
    {
        NavigationManager.NavigateTo($"/workflow?repo={SelectedRepo}");
    }

    private void ShowErrorToast(string message)
    {
        ToastMessage = message;
        ToastType = Toast.ToastType.Error;
        ShowToast = true;
    }

    private void CloseToast()
    {
        ShowToast = false;
    }

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    [Inject]
    private MinGo.Gitea.Application.Services.WorkflowService WorkflowService { get; set; } = default!;
}