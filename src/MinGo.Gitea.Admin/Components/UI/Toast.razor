@if (Visible)
{
    <div
        class="toast fixed bottom-5 left-1/2 transform -translate-x-1/2 flex flex-row items-center gap-2 z-50 transition-all duration-300 @(Visible ? "translate-y-0 opacity-100" : "translate-y-10 opacity-0")">
        <div class="p-3 rounded-md shadow-lg @ToastClass">
            @Message
        </div>
    </div>
}

<style>
    .toast {
        transition: all 0.3s ease;
    }
</style>

@code {
    [Parameter]
    public string? Message { get; set; }

    [Parameter]
    public ToastType Type { get; set; } = ToastType.Success;

    [Parameter]
    public bool Visible { get; set; } = false;

    [Parameter]
    public EventCallback OnClose { get; set; }

    private string ToastClass
    {
        get
        {
            switch (Type)
            {
                case ToastType.Success:
                    return "bg-green-100 text-green-700";
                case ToastType.Warning:
                    return "bg-yellow-100 text-yellow-700";
                case ToastType.Error:
                    return "bg-red-100 text-red-700";
                default:
                    return "bg-gray-100 text-gray-700";
            }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Visible)
        {
            // 3秒后自动关闭
            await Task.Delay(3000);
            await OnClose.InvokeAsync();
        }
    }

    public enum ToastType
    {
        Success,
        Warning,
        Error
    }
}