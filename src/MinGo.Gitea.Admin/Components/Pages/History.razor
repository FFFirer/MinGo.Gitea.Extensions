@page "/history"

<h1 class="text-2xl font-semibold text-ink mb-6">执行历史</h1>

<Card Title="最近执行记录">
    <div class="mb-4">
        <label class="block text-sm font-medium text-ink mb-2" for="history-filter">过滤</label>
        <input type="text" class="w-full px-3 py-2 border border-line rounded-md focus:outline-none focus:ring-2 focus:ring-accent-btn" id="history-filter" placeholder="输入关键词搜索" @bind="filter" @bind:event="oninput">
    </div>
    <button class="px-4 py-2 bg-accent-btn text-on-accent rounded-md hover:bg-accent-btn-hover transition-colors" @onclick="LoadHistories">刷新</button>
</Card>

<Card Title="执行记录列表">
    <div class="overflow-x-auto">
        <table class="w-full border-collapse">
            <thead>
                <tr class="border-b border-line">
                    <th class="px-4 py-3 text-left text-sm font-semibold text-ink">历史记录Id</th>
                    <th class="px-4 py-3 text-left text-sm font-semibold text-ink">工作流</th>
                    <th class="px-4 py-3 text-left text-sm font-semibold text-ink">仓库</th>
                    <th class="px-4 py-3 text-left text-sm font-semibold text-ink">分支</th>
                    <th class="px-4 py-3 text-left text-sm font-semibold text-ink">状态</th>
                    <th class="px-4 py-3 text-left text-sm font-semibold text-ink">结果</th>
                    <th class="px-4 py-3 text-left text-sm font-semibold text-ink">开始时间</th>
                    <th class="px-4 py-3 text-left text-sm font-semibold text-ink">执行时间</th>
                    <th class="px-4 py-3 text-left text-sm font-semibold text-ink">操作</th>
                </tr>
            </thead>
            <tbody>
                @if (histories != null && histories.Any())
                {
                    @foreach (var history in histories)
                    {
                        <tr class="border-b border-line hover:bg-surface-2 transition-colors">
                            <td class="px-4 py-3 text-sm text-ink">@history.Id</td>
                            <td class="px-4 py-3 text-sm text-ink">@history.WorkflowName</td>
                            <td class="px-4 py-3 text-sm text-ink-muted">
                                <span class="px-1.5 py-0.5 text-xs rounded-full @(history.Provider == MinGo.Gitea.Core.Models.ProviderType.GitHub ? "bg-ink text-surface" : "bg-success-soft text-success") mr-1">@(history.Provider == MinGo.Gitea.Core.Models.ProviderType.GitHub ? "GH" : "GT")</span>
                                @history.Repo
                            </td>
                            <td class="px-4 py-3 text-sm text-ink-muted">@history.Ref</td>
                            <td class="px-4 py-3">
                                <StatusBadge Status="@history.Status.ToLower()" />
                            </td>
                            <td class="px-4 py-3 text-sm text-ink-muted">@(string.IsNullOrEmpty(history.Conclusion) ? "-" : history.Conclusion)</td>
                            <td class="px-4 py-3 text-sm text-ink-muted">@history.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td class="px-4 py-3 text-sm text-ink-muted">@GetExecutionTime(history)</td>
                            <td class="px-4 py-3">
                                <NavLink class="text-xs px-2 py-1 bg-surface border border-line rounded hover:bg-surface-2 transition-colors" href="@($"/history/{history.Id}")">查看</NavLink>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="px-4 py-8 text-center text-ink-muted">暂无执行记录</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    
    @if (totalCount > 0)
    {
        <div class="mt-4 flex justify-between items-center">
            <div class="text-sm text-ink-muted">
                显示 @((page - 1) * pageSize + 1) - @Math.Min(page * pageSize, totalCount) 条，共 @totalCount 条
            </div>
            <div class="flex space-x-2">
                <button class="px-3 py-1 border border-line rounded-md hover:bg-surface-2" @onclick="() => ChangePage(1)" disabled="@(page == 1)">首页</button>
                <button class="px-3 py-1 border border-line rounded-md hover:bg-surface-2" @onclick="() => ChangePage(page - 1)" disabled="@(page == 1)">上一页</button>
                <span class="px-3 py-1 border border-line rounded-md bg-surface-2">@(page)</span>
                <button class="px-3 py-1 border border-line rounded-md hover:bg-surface-2" @onclick="() => ChangePage(page + 1)" disabled="@(page >= totalPages)">下一页</button>
                <button class="px-3 py-1 border border-line rounded-md hover:bg-surface-2" @onclick="() => ChangePage(totalPages)" disabled="@(page >= totalPages)">末页</button>
            </div>
        </div>
    }
</Card>

@code {
    private List<MinGo.Gitea.Core.Models.WorkflowRunHistory> histories = new();
    private int totalCount = 0;
    private int page = 1;
    private int pageSize = 10;
    private string filter = string.Empty;
    
    private int totalPages => (int)Math.Ceiling((double)totalCount / pageSize);
    
    [Inject]
    private MinGo.Gitea.Application.Services.WorkflowService WorkflowService { get; set; } = default!;
    
    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;
    
    protected override async Task OnInitializedAsync()
    {
        await LoadHistories();
    }
    
    private async Task LoadHistories()
    {
        var result = await WorkflowService.GetWorkflowRunHistoriesAsync(page, pageSize, filter);
        histories = result.Item1.ToList();
        totalCount = result.Item2;
    }
    
    private async Task ChangePage(int newPage)
    {
        if (newPage >= 1 && newPage <= totalPages)
        {
            page = newPage;
            await LoadHistories();
        }
    }
    
    /// <summary>
    /// 计算工作流执行时间
    /// </summary>
    /// <param name="history">工作流执行历史</param>
    /// <returns>执行时间字符串</returns>
    private string GetExecutionTime(MinGo.Gitea.Core.Models.WorkflowRunHistory history)
    {
        if (!history.StartedAt.HasValue)
        {
            return "未知";
        }
        
        if (!history.EndedAt.HasValue)
        {
            return "运行中";
        }
        
        var duration = history.EndedAt.Value - history.StartedAt.Value;
        return $"{duration.Minutes}m {duration.Seconds}s";
    }
}