@page "/settings"
@inject MinGo.Gitea.Application.Services.ProviderConnectionService ConnectionService
@inject MinGo.Gitea.Infrastructure.ActionsClientFactory ClientFactory

<h1 class="text-2xl font-semibold text-gray-800 mb-6">连接管理</h1>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <Card Title="已有连接">
        @if (Connections.Count == 0)
        {
            <p class="text-gray-500">暂无连接，请在右侧添加 Gitea 或 GitHub 连接。</p>
        }
        else
        {
            <div class="space-y-3">
                @foreach (var c in Connections)
                {
                    <div class="flex items-start justify-between border border-gray-200 rounded-md p-3">
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="px-2 py-0.5 text-xs rounded-full @(c.ProviderType == ProviderType.GitHub ? "bg-gray-800 text-white" : "bg-green-100 text-green-800")">
                                    @(c.ProviderType == ProviderType.GitHub ? "GitHub" : "Gitea")
                                </span>
                                <span class="font-medium text-gray-800">@c.Name</span>
                                @if (!c.IsEnabled)
                                {
                                    <span class="text-xs text-amber-600">已停用</span>
                                }
                            </div>
                            <div class="text-sm text-gray-500 mt-1">@c.ServerUrl</div>
                            <div class="text-xs text-gray-400">@c.Username</div>
                        </div>
                        <div class="flex gap-2">
                            <button class="text-sm text-blue-600 hover:underline" @onclick="() => EditConnection(c)">编辑</button>
                            <button class="text-sm text-red-600 hover:underline" @onclick="() => DeleteConnection(c.Id)">删除</button>
                        </div>
                    </div>
                }
            </div>
        }
    </Card>

    <Card Title="@(EditingId > 0 ? "编辑连接" : "添加连接")">
        <div class="mb-4">
            <label class="block text-sm font-medium text-gray-800 mb-2">平台</label>
            <div class="flex gap-2">
                <button type="button" class="px-3 py-2 rounded-md border @(FormProvider == ProviderType.Gitea ? "bg-blue-600 text-white border-blue-600" : "border-gray-300")"
                        @onclick="() => FormProvider = ProviderType.Gitea">Gitea</button>
                <button type="button" class="px-3 py-2 rounded-md border @(FormProvider == ProviderType.GitHub ? "bg-blue-600 text-white border-blue-600" : "border-gray-300")"
                        @onclick="() => FormProvider = ProviderType.GitHub">GitHub</button>
            </div>
        </div>
        <div class="mb-4">
            <label class="block text-sm font-medium text-gray-800 mb-2" for="conn-name">名称</label>
            <input type="text" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" id="conn-name" placeholder="例如：公司 Gitea / 个人 GitHub" @bind="FormName">
        </div>
        <div class="mb-4">
            <label class="block text-sm font-medium text-gray-800 mb-2" for="conn-url">@(FormProvider == ProviderType.GitHub ? "API URL（默认 https://api.github.com）" : "Gitea URL")</label>
            <input type="text" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" id="conn-url"
                   placeholder="@(FormProvider == ProviderType.GitHub ? "https://api.github.com" : "https://gitea.example.com")" @bind="FormUrl">
        </div>
        <div class="mb-4">
            <label class="block text-sm font-medium text-gray-800 mb-2" for="conn-token">API Token</label>
            <input type="password" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" id="conn-token" placeholder="输入 API Token / PAT" @bind="FormToken">
        </div>
        <div class="mb-4">
            <label class="block text-sm font-medium text-gray-800 mb-2" for="conn-username">用户名</label>
            <input type="text" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" id="conn-username" placeholder="输入用户名" @bind="FormUsername">
        </div>
        <div class="mb-4 flex items-center gap-2">
            <input type="checkbox" id="conn-enabled" @bind="FormEnabled">
            <label for="conn-enabled" class="text-sm text-gray-800">启用</label>
        </div>
        <div class="flex gap-2">
            <button class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors" @onclick="SaveConnection" disabled="@IsLoading">
                @(IsLoading ? "保存中..." : (EditingId > 0 ? "保存修改" : "添加连接"))
            </button>
            <button class="px-4 py-2 border border-gray-300 rounded-md hover:bg-gray-50" @onclick="TestConnection" disabled="@IsLoading">测试连接</button>
            @if (EditingId > 0)
            {
                <button class="px-4 py-2 border border-gray-300 rounded-md hover:bg-gray-50" @onclick="ResetForm">取消编辑</button>
            }
        </div>
    </Card>
</div>

<Toast Message="@ToastMessage" Type="@ToastType" Visible="@ShowToast" OnClose="CloseToast" />

@code {
    private List<ProviderConnection> Connections { get; set; } = new();

    private int EditingId { get; set; }
    private ProviderType FormProvider { get; set; } = ProviderType.Gitea;
    private string FormName { get; set; } = "";
    private string FormUrl { get; set; } = "";
    private string FormToken { get; set; } = "";
    private string FormUsername { get; set; } = "";
    private bool FormEnabled { get; set; } = true;

    private string ToastMessage { get; set; } = "";
    private Toast.ToastType ToastType { get; set; } = Toast.ToastType.Success;
    private bool ShowToast { get; set; }
    private bool IsLoading { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadConnections();
    }

    private async Task LoadConnections()
    {
        Connections = await ConnectionService.GetAllAsync();
    }

    private void EditConnection(ProviderConnection c)
    {
        EditingId = c.Id;
        FormProvider = c.ProviderType;
        FormName = c.Name;
        FormUrl = c.ServerUrl;
        FormToken = c.Token;
        FormUsername = c.Username;
        FormEnabled = c.IsEnabled;
    }

    private void ResetForm()
    {
        EditingId = 0;
        FormProvider = ProviderType.Gitea;
        FormName = "";
        FormUrl = "";
        FormToken = "";
        FormUsername = "";
        FormEnabled = true;
    }

    private async Task SaveConnection()
    {
        if (string.IsNullOrWhiteSpace(FormUrl) || string.IsNullOrWhiteSpace(FormToken))
        {
            ShowErrorToast("请填写 URL 和 Token");
            return;
        }

        IsLoading = true;
        try
        {
            var conn = new ProviderConnection
            {
                Id = EditingId,
                Name = string.IsNullOrWhiteSpace(FormName) ? FormProvider.ToString() : FormName,
                ProviderType = FormProvider,
                ServerUrl = FormProvider == ProviderType.GitHub && string.IsNullOrWhiteSpace(FormUrl)
                    ? "https://api.github.com"
                    : FormUrl.Trim(),
                Token = FormToken,
                Username = FormUsername,
                IsEnabled = FormEnabled
            };

            var saved = await ConnectionService.SaveAsync(conn);
            if (saved != null)
            {
                ShowSuccessToast(EditingId > 0 ? "连接已更新" : "连接已添加");
                ResetForm();
                await LoadConnections();
            }
            else
            {
                ShowErrorToast("保存失败");
            }
        }
        catch (Exception ex)
        {
            ShowErrorToast($"保存失败：{ex.Message}");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task DeleteConnection(int id)
    {
        await ConnectionService.DeleteAsync(id);
        if (EditingId == id) ResetForm();
        await LoadConnections();
        ShowSuccessToast("连接已删除");
    }

    private async Task TestConnection()
    {
        if (string.IsNullOrWhiteSpace(FormUrl) || string.IsNullOrWhiteSpace(FormToken))
        {
            ShowErrorToast("请填写 URL 和 Token");
            return;
        }

        IsLoading = true;
        try
        {
            var conn = new ProviderConnection
            {
                Name = "test",
                ProviderType = FormProvider,
                ServerUrl = FormProvider == ProviderType.GitHub && string.IsNullOrWhiteSpace(FormUrl)
                    ? "https://api.github.com"
                    : FormUrl.Trim(),
                Token = FormToken,
                Username = FormUsername
            };
            var client = ClientFactory.Create(conn);
            var ok = await client.TestConnectionAsync();
            if (ok) ShowSuccessToast("连接成功");
            else ShowErrorToast("连接失败，请检查 URL / Token");
        }
        catch (Exception ex)
        {
            ShowErrorToast($"连接测试失败：{ex.Message}");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void ShowSuccessToast(string message)
    {
        ToastMessage = message;
        ToastType = Toast.ToastType.Success;
        ShowToast = true;
    }

    private void ShowErrorToast(string message)
    {
        ToastMessage = message;
        ToastType = Toast.ToastType.Error;
        ShowToast = true;
    }

    private void CloseToast() => ShowToast = false;
}
