@page "/dispatch-workflow"

@using MinGo.Gitea.Core.Models
@using Microsoft.Extensions.Logging

<h1 class="text-2xl font-semibold text-ink mb-6">手动触发工作流执行</h1>

<Steps CurrentStep="CurrentStep" />

@* 步骤1：选择仓库 *@
@if (CurrentStep == 1)
{
    <Card Title="选择仓库">
        <div class="mb-4">
            <label class="block text-sm font-medium text-ink mb-2" for="repo-select">仓库</label>
            <div class="relative">
                @if (IsLoadingRepos)
                {
                    <div class="absolute inset-0 flex items-center justify-center bg-surface/80 z-10">
                        <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-accent-btn"></div>
                    </div>
                }
                <select class="w-full px-3 py-2 border border-line rounded-md focus:outline-none focus:ring-2 focus:ring-accent-btn" id="repo-select" @bind="SelectedRepoId" @bind:after="RepoChanged">
                    <option value="">请选择仓库</option>
                    @foreach (var repo in Repositories)
                    {
                        <option value="@repo.Id">@($"[{(repo.Provider == MinGo.Gitea.Core.Models.ProviderType.GitHub ? "GitHub" : "Gitea")}] {repo.Owner}/{repo.Name}")</option>
                    }
                </select>
            </div>
        </div>
        <div class="mt-4 flex">
            <button class="px-4 py-2 bg-accent-btn text-on-accent rounded-md hover:bg-accent-btn-hover transition-colors" @onclick="NextStep" disabled="@(!SelectedRepoId.HasValue || IsLoadingRepos)">
                下一步
            </button>
        </div>
    </Card>
}

@* 步骤2：选择工作流 *@
@if (CurrentStep == 2)
{
    <Card Title="选择工作流">
        <div class="mb-4">
            <label class="block text-sm font-medium text-ink mb-2">工作流</label>
            @if (IsLoadingWorkflows)
            {
                <div class="flex justify-center items-center py-8">
                    <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-accent-btn"></div>
                </div>
            }
            else if (Workflows.Count == 0)
            {
                <div class="text-center py-8 text-ink-muted">
                    该仓库没有可用的工作流
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                    @foreach (var workflow in Workflows)
                    {
                        <WorkflowCard 
                            Name="@workflow.Name" 
                            Description="@workflow.Path" 
                            Branch="@workflow.State" 
                            IsActive="SelectedWorkflowId == workflow.Id.ToString()"
                            OnSelect="(name) => SelectWorkflow(workflow.Id.ToString())"
                        />
                    }
                </div>
            }
        </div>
        <div class="mt-4 flex justify-start gap-2">
            <button class="px-4 py-2 bg-surface border border-line rounded-md hover:bg-surface-2 transition-colors" @onclick="PrevStep">
                上一步
            </button>
            <button class="px-4 py-2 bg-accent-btn text-on-accent rounded-md hover:bg-accent-btn-hover transition-colors" @onclick="NextStep" disabled="@(string.IsNullOrEmpty(SelectedWorkflowId) || IsLoadingWorkflows)">
                下一步
            </button>
        </div>
    </Card>
}

@* 步骤3：选择引用 *@
@if (CurrentStep == 3)
{
    <Card Title="选择引用">
        <div class="mb-4">
            <label class="block text-sm font-medium text-ink mb-2" for="ref-select">引用（分支或标签）</label>
            <div class="relative">
                @if (IsLoadingRefs)
                {
                    <div class="absolute inset-0 flex items-center justify-center bg-surface/80 z-10">
                        <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-accent-btn"></div>
                    </div>
                    <select class="w-full px-3 py-2 border border-line rounded-md focus:outline-none focus:ring-2 focus:ring-accent-btn" disabled>
                        <option value="">加载中...</option>
                    </select>
                }
                else
                {
                    <select class="w-full px-3 py-2 border border-line rounded-md focus:outline-none focus:ring-2 focus:ring-accent-btn" id="ref-select" @bind="SelectedRef">
                        <option value="">请选择引用</option>
                        @foreach (var @ref in Refs)
                        {
                            <option value="@(@ref.Name)">@(@ref.Type == "branch" ? "分支: " : "标签: ")@(@ref.Name.Split('/')[2])</option>
                        }
                    </select>
                }
            </div>
        </div>
        <div class="mt-4 flex justify-start gap-2">
            <button class="px-4 py-2 bg-surface border border-line rounded-md hover:bg-surface-2 transition-colors" @onclick="PrevStep">
                上一步
            </button>
            <button class="px-4 py-2 bg-accent-btn text-on-accent rounded-md hover:bg-accent-btn-hover transition-colors" @onclick="NextStep" disabled="@(string.IsNullOrEmpty(SelectedRef) || IsLoadingRefs)">
                下一步
            </button>
        </div>
    </Card>
}

@* 步骤4：触发工作流 *@
@if (CurrentStep == 4)
{
    <Card Title="执行信息">
        <div class="mb-4">
            <label class="block text-sm font-medium text-ink mb-2">仓库</label>
            <div class="w-full px-3 py-2 border border-line rounded-md bg-surface-2 cursor-default">@SelectedRepoName</div>
        </div>
        <div class="mb-4">
            <label class="block text-sm font-medium text-ink mb-2">工作流</label>
            <div class="w-full px-3 py-2 border border-line rounded-md bg-surface-2 cursor-default">@SelectedWorkflowName</div>
        </div>
        <div class="mb-4">
            <label class="block text-sm font-medium text-ink mb-2">引用</label>
            <div class="w-full px-3 py-2 border border-line rounded-md bg-surface-2 cursor-default">@SelectedRef</div>
        </div>
        @if (WorkflowInputs.Count > 0)
        {
            <div class="mb-4">
                <label class="block text-sm font-medium text-ink mb-2">输入参数</label>
                @if (IsLoadingInputs)
                {
                    <div class="flex justify-center items-center py-4">
                        <div class="animate-spin rounded-full h-6 w-6 border-b-2 border-accent-btn"></div>
                    </div>
                }
                else
                {
                    <div class="space-y-4">
                        @foreach (var input in WorkflowInputs)
                        {
                            <div>
                                <label class="block text-sm font-medium text-ink mb-1">
                                    @input.Name
                                    @if (input.Required)
                                    {
                                        <span class="text-danger">*</span>
                                    }
                                    @if (!string.IsNullOrEmpty(input.Description))
                                    {
                                        <span class="text-ink-muted text-xs ml-1">- @input.Description</span>
                                    }
                                </label>
                                @switch (input.Type)
                                {
                                    case "boolean":
                                        <div class="flex items-center">
                                            <input type="checkbox" 
                                                   class="h-4 w-4 text-accent border-line rounded focus:ring-accent-btn"
                                                   checked="@GetBoolValue(input.Name)"
                                                   @onchange="@(e => OnBoolInputChanged(input.Name, e.Value?.ToString() ?? "false"))">
                                            <span class="ml-2 text-sm text-ink-muted">@GetBoolDisplay(input.Name)</span>
                                        </div>
                                        break;
                                    case "choice":
                                        <select class="w-full px-3 py-2 border border-line rounded-md focus:outline-none focus:ring-2 focus:ring-accent-btn"
                                                value="@GetValue(input.Name)"
                                                @onchange="@(e => OnInputChanged(input.Name, e.Value?.ToString() ?? ""))">
                                            @foreach (var option in ChoiceOptions(input))
                                            {
                                                <option value="@option">@option</option>
                                            }
                                        </select>
                                        break;
                                    default:
                                        <input type="text" 
                                               class="w-full px-3 py-2 border border-line rounded-md focus:outline-none focus:ring-2 focus:ring-accent-btn"
                                               value="@GetValue(input.Name)"
                                               placeholder="@DefaultHint(input)"
                                               @oninput="@(e => OnInputChanged(input.Name, e.Value?.ToString() ?? ""))">
                                        break;
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
        <div class="mt-4 flex justify-start gap-2">
            <button class="px-4 py-2 bg-surface border border-line rounded-md hover:bg-surface-2 transition-colors" @onclick="PrevStep">
                上一步
            </button>
            <button class="px-4 py-2 bg-accent-btn text-on-accent rounded-md hover:bg-accent-btn-hover transition-colors" @onclick="Start" disabled="@IsTriggering">
                @(IsTriggering ? "触发中..." : "确认触发")
            </button>
        </div>
    </Card>
}

<Toast Message="@ToastMessage" Type="@ToastType" Visible="@ShowToast" OnClose="CloseToast" />

@code {
    private int CurrentStep { get; set; } = 1;
    private int? SelectedRepoId { get; set; } 
    private string SelectedRepoName
    {
        get{
            var repo = Repositories.FirstOrDefault(r => r.Id == SelectedRepoId);
            return repo != null ? $"{repo.Owner}/{repo.Name}" : "";
        }
    }
    private string SelectedWorkflowId { get; set; } = "";
    private string SelectedWorkflowName { get; set; } = "";
    private string SelectedWorkflowPath { get; set; } = "";
    private string SelectedRef { get; set; } = "";
    private string ToastMessage { get; set; } = "";
    private Toast.ToastType ToastType { get; set; } = Toast.ToastType.Success;
    private bool ShowToast { get; set; } = false;
    private List<MinGo.Gitea.Core.Models.Repository> Repositories { get; set; } = new List<MinGo.Gitea.Core.Models.Repository>();
    private List<MinGo.Gitea.Core.Models.Workflow> Workflows { get; set; } = new List<MinGo.Gitea.Core.Models.Workflow>();
    private List<MinGo.Gitea.Core.Models.Ref> Refs { get; set; } = new List<MinGo.Gitea.Core.Models.Ref>();
    private List<MinGo.Gitea.Core.Models.WorkflowInput> WorkflowInputs { get; set; } = new List<MinGo.Gitea.Core.Models.WorkflowInput>();
    private Dictionary<string, string> InputValues { get; set; } = new Dictionary<string, string>();
    private bool IsLoadingRepos { get; set; } = false;
    private bool IsLoadingWorkflows { get; set; } = false;
    private bool IsLoadingRefs { get; set; } = false;
    private bool IsLoadingInputs { get; set; } = false;
    private bool IsTriggering { get; set; } = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadRepositoriesAsync();
    }

    private async Task LoadRepositoriesAsync()
    {
        IsLoadingRepos = true;
        try
        {
            var repositories = await WorkflowService.GetRepositoriesAsync();
            Repositories = repositories.ToList();
        }
        catch (Exception ex)
        {
            ShowErrorToast($"加载仓库失败: {ex.Message}");
        }
        finally
        {
            IsLoadingRepos = false;
        }
    }

    private async Task RepoChanged()
    {
        SelectedWorkflowId = "";
        SelectedWorkflowName = "";
        SelectedRef = "";
        Workflows.Clear();
        Refs.Clear();
        
        if (SelectedRepoId > 0)
        {
            await LoadWorkflowsAsync();
        }
    }

    private async Task LoadWorkflowsAsync()
    {
        IsLoadingWorkflows = true;
        try
        {
            var repo = ParseRepo(SelectedRepoId);
            if(repo is null){
                return;
            }
            var workflows = await WorkflowService.GetWorkflowsAsync(repo.Owner, repo.Name, repo.ConnectionId);
            Workflows = workflows.ToList();
        }
        catch (Exception ex)
        {
            ShowErrorToast($"加载工作流失败: {ex.Message}");
        }
        finally
        {
            IsLoadingWorkflows = false;
        }
    }

    private async Task SelectWorkflow(string workflowId)
    {
        SelectedWorkflowId = workflowId;
        SelectedRef = "";
        Refs.Clear();
        WorkflowInputs.Clear();
        InputValues.Clear();
        
        var workflow = Workflows.FirstOrDefault(w => w.Id.ToString() == workflowId);
        if (workflow != null)
        {
            SelectedWorkflowName = workflow.Name;
            SelectedWorkflowPath = workflow.Path;
            await LoadWorkflowInputsAsync();
        }
        
        await LoadRefsAsync();
    }

    private async Task LoadWorkflowInputsAsync()
    {
        if (!(SelectedRepoId > 0) || string.IsNullOrEmpty(SelectedWorkflowPath))
        {
            return;
        }
        
        IsLoadingInputs = true;
        try
        {
            var repo = ParseRepo(SelectedRepoId);
            if (repo is null)
            {
                return;
            }
            var inputs = await WorkflowService.GetWorkflowInputsAsync(repo.Owner, repo.Name, SelectedWorkflowPath, repo.ConnectionId);
            WorkflowInputs = inputs;
            SeedInputDefaults();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "加载工作流输入参数失败: {Repo} {Path}", SelectedRepoName, SelectedWorkflowPath);
            WorkflowInputs = new List<MinGo.Gitea.Core.Models.WorkflowInput>();
        }
        finally
        {
            IsLoadingInputs = false;
        }
    }

    private async Task LoadRefsAsync()
    {
        if (!(SelectedRepoId > 0)) return;
        
        IsLoadingRefs = true;
        try
        {
            var repo = ParseRepo(SelectedRepoId);
            if(repo is null){
                return;
            }
            var refs = await WorkflowService.GetRefsAsync(repo.Owner, repo.Name, repo.ConnectionId);
            Refs = refs.ToList();
        }
        catch (Exception ex)
        {
            ShowErrorToast($"加载引用失败: {ex.Message}");
        }
        finally
        {
            IsLoadingRefs = false;
        }
    }

    private Repository? ParseRepo(int? id) => Repositories.FirstOrDefault(r => r.Id == id);

    private void NextStep()
    {
        if (CurrentStep < 4)
        {
            CurrentStep++;
        }
    }

    private void OnInputChanged(string name, string value)
    {
        InputValues[name] = value;
    }

    private void OnBoolInputChanged(string name, string value)
    {
        InputValues[name] = value == "true" ? "true" : "false";
    }

    private bool GetBoolValue(string name) => IsTruthy(GetValue(name));

    private string GetBoolDisplay(string name)
    {
        return GetBoolValue(name) ? "是" : "否";
    }

    private void PrevStep()
    {
        if (CurrentStep > 1)
        {
            CurrentStep--;
            if (CurrentStep < 4)
            {
                SeedInputDefaults();
            }
        }
    }

    private void SeedInputDefaults()
    {
        InputValues.Clear();
        foreach (var input in WorkflowInputs)
        {
            var value = input.Type == "boolean"
                ? (string.IsNullOrEmpty(input.DefaultValue) ? "" : (IsTruthy(input.DefaultValue) ? "true" : "false"))
                : input.DefaultValue ?? "";
            if (!string.IsNullOrEmpty(value))
            {
                InputValues[input.Name] = value;
            }
        }
    }

    // YAML 的 true/false 反序列化后可能是 "True"/"False"，统一按不区分大小写判断
    private static bool IsTruthy(string? value) => bool.TryParse(value, out var parsed) && parsed;

    private string GetValue(string name) => InputValues.TryGetValue(name, out var value) ? value : "";

    private static string DefaultHint(WorkflowInput input)
        => string.IsNullOrEmpty(input.DefaultValue) ? "" : $"默认: {input.DefaultValue}";

    private static List<string> ChoiceOptions(WorkflowInput input)
    {
        var options = input.Options ?? new List<string>();
        if (!string.IsNullOrEmpty(input.DefaultValue) && !options.Contains(input.DefaultValue))
        {
            options = options.Prepend(input.DefaultValue).ToList();
        }
        return options;
    }

    private async Task Start()
    {
        if (!(SelectedRepoId > 0) || string.IsNullOrEmpty(SelectedWorkflowId) || string.IsNullOrEmpty(SelectedRef))
        {
            ShowErrorToast("请完成所有选择步骤");
            return;
        }

        var requiredInputs = WorkflowInputs.Where(i => i.Required).ToList();
        foreach (var input in requiredInputs)
        {
            if (!InputValues.TryGetValue(input.Name, out var value) || string.IsNullOrEmpty(value))
            {
                ShowErrorToast($"请填写必填参数: {input.Name}");
                return;
            }
        }
        
        IsTriggering = true;
        try
        {
            var repo = ParseRepo(SelectedRepoId);
            if(repo is null){
                return;
            }
            var selectedWorkflow = Workflows.First(x => x.Id == SelectedWorkflowId);
            var selectedRef = Refs.First(x => x.Name == SelectedRef);
            
            var inputs = InputValues.Where(kv => !string.IsNullOrEmpty(kv.Value)).ToDictionary(kv => kv.Key, kv => kv.Value);
            var workflowRun = await WorkflowService.TriggerWorkflowAsync(repo.Owner, repo.Name, selectedWorkflow, selectedRef, "手动触发", inputs);
            if (workflowRun != null)
            {
                ShowSuccessToast("工作流触发成功");
                NavigationManager.NavigateTo($"/history/{workflowRun.Id}");
            }
            else
            {
                ShowErrorToast("工作流触发失败");
            }
        }
        catch (Exception ex)
        {
            ShowErrorToast($"触发工作流失败: {ex.Message}");
        }
        finally
        {
            IsTriggering = false;
        }
    }

    private void ShowSuccessToast(string message)
    {
        ToastMessage = message;
        ToastType = Toast.ToastType.Success;
        ShowToast = true;
    }

    private void ShowErrorToast(string message)
    {
        ToastMessage = message;
        ToastType = Toast.ToastType.Error;
        ShowToast = true;
    }

    private void CloseToast()
    {
        ShowToast = false;
    }

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    [Inject]
    private ILogger<DispatchWorkflow> Logger { get; set; } = default!;

    [Inject]
    private MinGo.Gitea.Application.Services.WorkflowService WorkflowService { get; set; } = default!;
}